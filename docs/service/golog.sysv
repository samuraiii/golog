#!/bin/sh
### BEGIN INIT INFO
# Provides:          golog
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: golog logbook server
### END INIT INFO
# /etc/init.d/golog (sysv init; use the systemd unit where there is systemd)
DAEMON=/usr/local/bin/gologd
PIDFILE=/run/golog.pid
ARGS="-c /etc/golog/golog.cfg -p 8080 -S -D"

case "${1}" in
start)
    # -D makes gologd detach itself; -f writes the pid file
    "${DAEMON}" ${ARGS} -f "${PIDFILE}" ;;
stop)
    if /usr/bin/test -f "${PIDFILE}"
    then
        /bin/kill -TERM "$(/bin/cat "${PIDFILE}")" && /bin/rm -f "${PIDFILE}"
    fi ;;
reload)
    /bin/kill -HUP "$(/bin/cat "${PIDFILE}")" ;;
restart)
    "${0}" stop; "${0}" start ;;
*)
    echo "usage: ${0} {start|stop|reload|restart}" >&2
    exit 2 ;;
esac
